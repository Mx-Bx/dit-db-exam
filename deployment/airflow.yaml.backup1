# airflow.yaml

# 1. ConfigMap for Airflow Environment Variables
apiVersion: v1
kind: ConfigMap
metadata:
  name: airflow-config
  namespace: data-pipeline
data:
  AIRFLOW__CORE__EXECUTOR: "CeleryExecutor"
  AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: "postgresql+psycopg2://airflow:airflow@postgres/airflow"
  AIRFLOW__CORE__FERNET_KEY: ""
  AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION: "true"
  AIRFLOW__CORE__LOAD_EXAMPLES: "false"
  AIRFLOW__API__AUTH_BACKENDS: "airflow.api.auth.backend.basic_auth"
  AIRFLOW__CELERY__BROKER_URL: "redis://:@redis:6379/0"
  AIRFLOW__CELERY__RESULT_BACKEND: "db+postgresql://airflow:airflow@postgres/airflow"
  AIRFLOW__CORE__ALLOWED_DESERIALIZATION_CLASSES: "airflow.*,astro.*"
---
# 2. PersistentVolume for DAGs and Logs
apiVersion: v1
kind: PersistentVolume
metadata:
  name: airflow-dags-pv
spec:
  capacity:
    storage: 1Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: local-path
  local:
    path: /mnt/data/airflow-dags
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - master
                - worker1
                - worker2
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: airflow-logs-pv
spec:
  capacity:
    storage: 1Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: local-path
  local:
    path: /mnt/data/airflow-logs
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - master
                - worker1
                - worker2

# 3. PersistentVolumeClaim for Logs and DAGs
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: airflow-logs-pvc
  namespace: data-pipeline
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
  storageClassName: local-path
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: airflow-dags-pvc
  namespace: data-pipeline
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
  storageClassName: local-path

# 4. Init Job for Airflow Database Initialization on the Master Node
---
apiVersion: batch/v1
kind: Job
metadata:
  name: airflow-init
  namespace: data-pipeline
  labels:
    app: airflow
spec:
  template:
    metadata:
      labels:
        app: airflow
    spec:
      serviceAccountName: airflow-admin
      securityContext:  # Add this section
        runAsUser: 0
        runAsGroup: 0
        fsGroup: 0
      nodeSelector:
        kubernetes.io/hostname: master
      containers:
        - name: airflow-init
          image: barryma22/airflow:2.4.2-python3.10
          command: ["airflow", "db", "init"]
          envFrom:
            - configMapRef:
                name: airflow-config
      restartPolicy: Never
  backoffLimit: 4

# 5. Deployment for Airflow Webserver on the Master Node
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: airflow-webserver
  namespace: data-pipeline
  labels:
    app: airflow
    component: webserver
spec:
  replicas: 1
  selector:
    matchLabels:
      app: airflow
      component: webserver
  template:
    metadata:
      labels:
        app: airflow
        component: webserver
    spec:
      serviceAccountName: airflow-admin
      securityContext:  # Add this section
        runAsUser: 0
        runAsGroup: 0
        fsGroup: 0
      nodeSelector:
        kubernetes.io/hostname: master
      initContainers:
        - name: check-db-init
          image: bitnami/kubectl:latest
          command:
            - /bin/sh
            - -c
            - |
              while [[ $(kubectl get job airflow-init -n data-pipeline -o jsonpath='{.status.succeeded}') != "1" ]]; do
                echo "Waiting for airflow-init job to complete..."
                sleep 2
              done
      containers:
        - name: airflow-webserver
          image: barryma22/airflow:2.4.2-python3.10
          command: ["airflow", "webserver"]
          ports:
            - containerPort: 8080
          envFrom:
            - configMapRef:
                name: airflow-config
          volumeMounts:
            - name: airflow-logs
              mountPath: /opt/airflow/logs
            - name: airflow-dags
              mountPath: /opt/airflow/dags
      volumes:
        - name: airflow-logs
          persistentVolumeClaim:
            claimName: airflow-logs-pvc
        - name: airflow-dags
          persistentVolumeClaim:
            claimName: airflow-dags-pvc

# 6. Scheduler on the Master Node
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: airflow-scheduler
  namespace: data-pipeline
  labels:
    app: airflow
    component: scheduler
spec:
  replicas: 1
  selector:
    matchLabels:
      app: airflow
      component: scheduler
  template:
    metadata:
      labels:
        app: airflow
        component: scheduler
    spec:
      serviceAccountName: airflow-admin
      securityContext:  # Add this section
        runAsUser: 0
        runAsGroup: 0
        fsGroup: 0
      nodeSelector:
        kubernetes.io/hostname: master
      containers:
        - name: airflow-scheduler
          image: barryma22/airflow:2.4.2-python3.10
          command: ["airflow", "scheduler"]
          envFrom:
            - configMapRef:
                name: airflow-config
          volumeMounts:
            - name: airflow-logs
              mountPath: /opt/airflow/logs
            - name: airflow-dags
              mountPath: /opt/airflow/dags
      volumes:
        - name: airflow-logs
          persistentVolumeClaim:
            claimName: airflow-logs-pvc
        - name: airflow-dags
          persistentVolumeClaim:
            claimName: airflow-dags-pvc

# 7. Airflow Worker on Worker2
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: airflow-worker
  namespace: data-pipeline
  labels:
    app: airflow
    component: worker
spec:
  replicas: 1
  selector:
    matchLabels:
      app: airflow
      component: worker
  template:
    metadata:
      labels:
        app: airflow
        component: worker
    spec:
      serviceAccountName: airflow-admin
      securityContext:  # Add this section
        runAsUser: 0
        runAsGroup: 0
        fsGroup: 0
      nodeSelector:
        kubernetes.io/hostname: worker2
      containers:
        - name: airflow-worker
          image: barryma22/airflow:2.4.2-python3.10
          command: ["airflow", "celery", "worker"]
          envFrom:
            - configMapRef:
                name: airflow-config
          volumeMounts:
            - name: airflow-logs
              mountPath: /opt/airflow/logs
            - name: airflow-dags
              mountPath: /opt/airflow/dags
      volumes:
        - name: airflow-logs
          persistentVolumeClaim:
            claimName: airflow-logs-pvc
        - name: airflow-dags
          persistentVolumeClaim:
            claimName: airflow-dags-pvc

# 8. Flower UI Deployment on Worker1
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: airflow-flower
  namespace: data-pipeline
  labels:
    app: airflow
    component: flower
spec:
  replicas: 1
  selector:
    matchLabels:
      app: airflow
      component: flower
  template:
    metadata:
      labels:
        app: airflow
        component: flower
    spec:
      serviceAccountName: airflow-admin
      securityContext:  # Add this section
        runAsUser: 0
        runAsGroup: 0
        fsGroup: 0
      nodeSelector:
        kubernetes.io/hostname: worker1
      containers:
        - name: airflow-flower
          image: barryma22/airflow:2.4.2-python3.10
          command: ["airflow", "celery", "flower"]
          ports:
            - containerPort: 5555
          envFrom:
            - configMapRef:
                name: airflow-config
---
# Flower UI Service
apiVersion: v1
kind: Service
metadata:
  name: airflow-flower
  namespace: data-pipeline
spec:
  selector:
    app: airflow
    component: flower
  ports:
    - port: 5555
      targetPort: 5555
      protocol: TCP

